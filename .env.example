# JWT 签名密钥（生产环境请替换为随机长字符串）
JWT_SECRET=your-secret-key-change-in-production

# 可选：自定义数据库路径（默认 ./data/circle.db）
# 部署到 Railway/Render 等平台时，指向持久化 Volume 的路径
# DB_PATH=/data/circle.db

# 可选：HTTP/SOCKS 代理（访问 Twitter 头像等外部资源时使用）
# HTTPS_PROXY=socks5h://127.0.0.1:7897
# HTTPS_PROXY=http://127.0.0.1:7890

# 可选：仅供 Yahoo 实时搜索使用的代理。
# http:// 地址按 forward proxy 使用；https:// 地址按兼容上游的中继服务根地址使用。
# YAHOO_PROXY=https://your-yahoo-relay.example.com/api/v1
